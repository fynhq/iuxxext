{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "iuxxext-fynhq@github.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "menus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-black-16.png",
      "32": "icons/icon-black-32.png",
      "48": "icons/icon-black-48.png",
      "128": "icons/icon-black-128.png"
    },
    "theme_icons": [
      {
        "light": "icons/icon-white-16.png",
        "dark": "icons/icon-black-16.png",
        "size": 16
      },
      {
        "light": "icons/icon-white-32.png",
        "dark": "icons/icon-black-32.png",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "start-picker": {
      "suggested_key": {
        "default": "Ctrl+Alt+X",
        "mac": "MacCtrl+Command+X"
      },
      "description": "__MSG_commandStartPicker__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
